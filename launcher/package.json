{
  "name": "shapez-multiplayer-launcher",
  "version": "1.6.0",
  "description": "Launcher and Relay Server for Shapez Multiplayer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.vanir.shapezmp",
    "productName": "Shapez Multiplayer Launcher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "publish": [{
      "provider": "github",
      "owner": "Vanir20342222",
      "repo": "Shapez-Multiplayer"
    }]
  },
  "author": "Vanir",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.21.0"
  }
}
